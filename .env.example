# CMS authentication credentials (admin_auth only)
TAPTOP_BASE_URL=https://example.invalid
TAPTOP_USERNAME=replace-me
TAPTOP_PASSWORD=replace-me

# CMS request settings (admin_auth, current downloader, uploader)
TAPTOP_CMS_URL=https://example.invalid/-/cms/v1
TAPTOP_ACCESS=replace-me
TAPTOP_VER_ID=0

# Service-specific CMS identifiers
TAPTOP_SHOP_ID=0
TAPTOP_DESIGN_ID=0
ADMIN_AUTH_SESSION_CACHE_TTL_SECONDS=14400

# Google Sheets reference downloader
GOOGLE_SHEET_URL=replace-with-spreadsheet-url
GOOGLE_SHEET_NAME=1. Для заливки
GOOGLE_AUTH_MODE=user
GOOGLE_CREDENTIALS_FILE=app/downloader/reference/credentials/client_secret.json
GOOGLE_TOKEN_FILE=app/downloader/reference/credentials/token.json
GOOGLE_SERVICE_ACCOUNT_FILE=app/downloader/reference/credentials/service_account_secret.json

# Telegram administrator notifications
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Use only letters, digits, dots, underscores, and dashes in these values.
# Generate long random values locally; do not commit the real .env file.
KAFKA_SASL_USERNAME=realclimate_app
KAFKA_SASL_PASSWORD=replace-with-a-long-random-secret
KAFKA_TLS_STORE_PASSWORD=replace-with-a-random-secret
SCHEDULE_TIMEZONE=Europe/Minsk

# Core Redis buffer for reference/current CSVs awaiting their correlated pair
CORE_PENDING_INPUT_TTL_SECONDS=86400
CORE_PROCESSING_CLAIM_TTL_SECONDS=7200

# Service heartbeat monitoring (optional; these defaults are used when unset)
HEALTH_HEARTBEAT_TIMEOUT_SECONDS=120
HEALTH_STARTUP_GRACE_SECONDS=180
HEALTH_CHECK_INTERVAL_SECONDS=10
# A worker that keeps sending heartbeats but has spent longer than this on one
# message is reported as stuck. Set it above the longest expected operation.
HEALTH_MAX_BUSY_SECONDS=5400
# Optional shorter limits for individual services, for example:
# HEALTH_MAX_BUSY_OVERRIDES=core=600,notifications=120
HEALTH_MAX_BUSY_OVERRIDES=
