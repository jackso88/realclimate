# CMS authentication credentials (admin_auth only)
TAPTOP_BASE_URL=https://example.invalid
TAPTOP_USERNAME=replace-me
TAPTOP_PASSWORD=replace-me

# CMS request settings (admin_auth, current downloader, uploader)
TAPTOP_CMS_URL=https://example.invalid/-/cms/v1
TAPTOP_ACCESS=replace-me
TAPTOP_VER_ID=0

# Service-specific CMS identifiers
TAPTOP_SHOP_ID=0
TAPTOP_DESIGN_ID=0

# Google Sheets reference downloader
GOOGLE_SHEET_URL=replace-with-spreadsheet-url
GOOGLE_SHEET_NAME=1. Для заливки
GOOGLE_CREDENTIALS_FILE=config/google/client_secret.json
GOOGLE_TOKEN_FILE=config/google/token.json

# Telegram administrator notifications
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SCHEDULE_TIMEZONE=Europe/Minsk
